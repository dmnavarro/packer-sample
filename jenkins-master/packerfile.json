{
  "variables": {
    "instance_price": "1.0",
    "infra_version": "v1.0.1",
    "jenkins_version": "2.164.1",
    "aws_region": "us-west-2",
    "aws_subnet": "subnet-0d0368f6d2952ca72",
    "ami_id": "ami-01ed306a12b7d1c96",
    "aws_instance": "t2.small",
    "ssh_user": "centos",
    "base_ami_name": "Base Jenkins Slave",
    "packer_profile": "packer-role",
    "aws_profile": "strata"
},
  "builders": [
    {
      "type": "amazon-ebs",
      "profile": "{{user `aws_profile`}}",
      "subnet_id": "{{user `aws_subnet`}}",
      "access_key": "{{user `aws_access_key`}}",
      "secret_key": "{{user `aws_secret_key`}}",
      "spot_price": "{{user `instance_price`}}",
      "region": "{{user `aws_region`}}",
      "source_ami": "{{user `ami_id`}}",
      "iam_instance_profile": "{{user `packer_profile`}}",
      "associate_public_ip_address": "false",
      "encrypt_boot": "true",
      "ssh_username": "{{user `ssh_user`}}",
      "instance_type": "{{user `aws_instance`}}",
      "run_tags": {
        "Name": "service-packer-builder"
      },
      "ami_name": "Base Jenkins Master {{user `infra_version`}} - {{user `jenkins_version`}}",
      "tags": {
        "Name": "Base Jenkins Master {{user `infra_version`}} - {{user `jenkins_version`}}",
        "Base_AMI_Name": "{{ .SourceAMIName }}",
        "Extra": "{{ .SourceAMITags.TagName }}"
      },
      "launch_block_device_mappings": [
        {
          "device_name": "/dev/sda1",
          "volume_size": 50,
          "volume_type": "gp2",
          "delete_on_termination": true
        }
      ]
    }
  ],

  "provisioners": [
    {
      "type": "file",
      "source": "configs/master-fstab.conf",
      "destination": "/tmp/fstab"
    },
    {
      "type": "file",
      "source": "configs/master-jenkins.conf",
      "destination": "/tmp/jenkins"
    },
    {
      "type": "file",
      "source": "jenkins-config",
      "destination": "/home/centos/"
    },
    {
      "type": "shell",
      "execute_command": "{{ .Vars }} /bin/bash -vx '{{ .Path }}'",
      "inline": [
        "sudo yum -y update",
        "sudo yum -y install java-1.8.0-openjdk-devel git telnet vim unzip wget epel-release",
        "sudo curl --silent --location http://pkg.jenkins-ci.org/redhat-stable/jenkins.repo | sudo tee /etc/yum.repos.d/jenkins.repo"
      ]
    },
    {
      "type": "shell",
      "execute_command": "{{ .Vars }} /bin/bash -vx '{{ .Path }}'",
      "inline": [
        "sudo rpm --import https://jenkins-ci.org/redhat/jenkins-ci.org.key",
        "sudo yum -y install jenkins-2.164.1-1.1.noarch",
        "sudo systemctl start jenkins",
        "sudo systemctl status jenkins",
        "sudo chkconfig --add jenkins"
      ]
    },
    {
      "type": "shell",
      "execute_command": "{{ .Vars }} /bin/bash -vx '{{ .Path }}'",
      "inline": [
        "sudo mv /etc/fstab /etc/fstab.unused",
        "sudo mv /tmp/fstab /etc/fstab",
        "sudo mkdir -p /mnt/efs"
      ]
    },
    {
      "type": "shell",
      "execute_command": "{{ .Vars }} /bin/bash -vx '{{ .Path }}'",
      "inline": [
        "sudo mv /etc/sysconfig/jenkins /etc/sysconfig/jenkins.unused",
        "sudo mv /tmp/jenkins /etc/sysconfig/jenkins",
        "sudo mkdir -p /data/jenkins-home",
        "sudo ln -s /mnt/efs/jenkins-jobs /data/jenkins-home/jobs",
        "sudo rm -rf /home/centos/jenkins-config/jobs",
        "sudo rm -rf /data/jenkins-home/*",
        "sudo rsync -avzpP --exclude=jobs /home/centos/jenkins-config/ /data/jenkins-home/",
        "sudo chown -R jenkins:jenkins /data/jenkins-home"
      ]
    },
    {
      "type": "shell",
      "execute_command": "{{ .Vars }} /bin/bash -vx '{{ .Path }}'",
      "inline": [
        "sudo wget https://releases.hashicorp.com/packer/1.3.5/packer_1.3.5_linux_amd64.zip",
        "sudo unzip packer_1.3.5_linux_amd64.zip",
        "sudo unlink /sbin/packer",
        "sudo mv packer packer-1.3.5",
        "sudo ln -s /home/centos/packer-1.3.5 /usr/local/bin/packer",
        "sudo ln -s /home/centos/packer-1.3.5 /usr/bin/packer"
      ]
    },
    {
      "type": "shell",
      "execute_command": "{{ .Vars }} /bin/bash -vx '{{ .Path }}'",
      "inline": [
        "sudo wget https://releases.hashicorp.com/terraform/0.11.13/terraform_0.11.13_linux_amd64.zip",
        "sudo unzip terraform_0.11.13_linux_amd64.zip",
        "sudo mv terraform terraform-0.11.13",
        "sudo ln -s /home/centos/terraform-0.11.13 /usr/local/bin/terraform",
        "sudo ln -s /home/centos/terraform-0.11.13 /usr/bin/terraform"
      ]
    },
    {
      "type": "shell",
      "execute_command": "{{ .Vars }} /bin/bash -vx '{{ .Path }}'",
      "inline": [
        "sudo yum -y install python-pip",
        "sudo pip install awscli",
        "aws --version",
        "packer --version"
      ]
    },
    {
      "type": "shell",
      "execute_command": "{{ .Vars }} /bin/bash -vx '{{ .Path }}'",
      "inline": [
        "mkdir -p /home/centos/.aws",
        "mkdir -p /home/centos/.keys",
        "aws ssm get-parameter --name 'strata-key' --region us-west-2 --query 'Parameter.Value' --output text > /home/centos/.keys/strata.key",
        "aws ssm get-parameter --name 'svcendeca-key' --region us-west-2 --query 'Parameter.Value' --output text > /home/centos/.keys/svcendeca.key",
        "aws ssm get-parameter --name 'defaults-aws' --region us-west-2 --query 'Parameter.Value' --output text > /home/centos/.aws/config",
        "aws ssm get-parameter --name 'credentials-aws' --region us-west-2 --query 'Parameter.Value' --output text > /home/centos/.aws/credentials",
        "chmod 400 /home/centos/.keys/*"
      ]
    }
  ]
}
