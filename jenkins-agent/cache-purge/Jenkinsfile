pipeline {
  environment {

    SCRIPT_SOURCE="Bastion-scripts/"
    PACKER_DIR="jenkins-agent/cache-purge/"

  }
  agent  {
    label "base-ec2-spot-worker"
  }
  stages {

    // Batch 1
    stage('Checkout Bastion Scripts') {
      agent {
        label "base-ec2-spot-worker"
      }
      steps {
        // check contents
        sh "ls -l"

        // print Directory
        sh "pwd"

        // checkout scripts
        dir("Bastion-scripts"){
          checkout scm: [
            $class: 'GitSCM',
            branches: [[name: "master"]],
            userRemoteConfigs: [[
              credentialsId: 'prd-private-gitlab',
              url: 'git@gitlab.usautoparts.com:platform-services/Bastion-scripts.git'
            ]]
          ]
        }
        // list after checkout
        sh "ls -l"
      }
      post {
        always {
          sh "date"
        }
      }
    }

    stage('Prepare Packer Build') {
      agent {
        label "base-ec2-spot-worker"
      }
      steps {

        // transfer scripts to agent working dir
        sh "rsync -avzpP ${SCRIPT_SOURCE} ${PACKER_DIR}"

        dir("${PACKER_DIR}"){

          sh "ls -l"

        }

      }
      post {
        always {
          sh "date"
        }
      }
    }

    stage('Build Cache Purge AMI') {
      agent {
        label "base-ec2-spot-worker"
      }
      steps {

        dir("${PACKER_DIR}"){

          sh "packer build packerfile.json"

        }

      }
      post {
        always {
          sh "date"
        }
      }
    }
  }
}
