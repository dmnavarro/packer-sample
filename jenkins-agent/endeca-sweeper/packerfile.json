{
  "variables": {
    "instance_price": "1.0",
    "infra_version": "v1.0.3",
    "aws_region": "us-west-2",
    "aws_subnet": "subnet-0952c4d29cfc85164",
    "ami_id": "ami-0151c34f6e3f89d7b",
    "aws_instance": "t2.small",
    "ssh_user": "centos",
    "base_ami_name": "Base Jenkins Agent Endeca Sweeper",
    "packer_profile": "packer-role",
    "aws_profile": "strata"
},
  "builders": [
    {
      "type": "amazon-ebs",
      "profile": "{{user `aws_profile`}}",
      "subnet_id": "{{user `aws_subnet`}}",
      "access_key": "{{user `aws_access_key`}}",
      "secret_key": "{{user `aws_secret_key`}}",
      "spot_price": "{{user `instance_price`}}",
      "region": "{{user `aws_region`}}",
      "source_ami": "{{user `ami_id`}}",
      "iam_instance_profile": "{{user `packer_profile`}}",
      "associate_public_ip_address": "false",
      "encrypt_boot": "true",
      "ssh_username": "{{user `ssh_user`}}",
      "instance_type": "{{user `aws_instance`}}",
      "run_tags": {
        "Name": "service-packer-builder"
      },
      "ami_name": "{{user `base_ami_name`}} {{user `infra_version`}}",
      "tags": {
        "Name": "{{user `base_ami_name`}} {{user `infra_version`}}",
        "Base_AMI_Name": "{{ .SourceAMIName }}",
        "Extra": "{{ .SourceAMITags.TagName }}"
      },
      "launch_block_device_mappings": [
        {
          "device_name": "/dev/sda1",
          "volume_size": 10,
          "volume_type": "gp2",
          "delete_on_termination": true
        }
      ]
    }
  ],

  "provisioners": [
    {
      "type": "file",
      "source": "endecaStackCleanup",
      "destination": "/home/centos/"
    },
    {
      "type": "shell",
      "execute_command": "{{ .Vars }} /bin/bash -vx '{{ .Path }}'",
      "inline": [
        "aws ssm get-parameter --name 'credentials-aws' --region us-west-2 --query 'Parameter.Value' --output text > /home/centos/.aws/credentials",
        "sudo yum -y install jq"
      ]
    }
  ]
}
