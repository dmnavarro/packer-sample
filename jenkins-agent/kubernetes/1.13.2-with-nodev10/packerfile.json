{
  "variables": {
    "instance_price": "1.0",
    "infra_version": "1.0.0",
    "kubernetes_ctl_version": "1.13.2",
    "docker_compose_version": "1.11.2",
    "aws_region": "us-west-2",
    "aws_subnet": "subnet-0d0368f6d2952ca72",
    "ami_id": "ami-0c663d99eef860d69",
    "aws_instance": "t2.small",
    "ssh_user": "centos",
    "base_ami_name": "PROD-JENKINS-AGENT",
    "application_name": "KUBERNETES-NODEv8",
    "packer_profile": "packer-role",
    "aws_profile": "strata",
    "root_dir": "/home/centos"
},
  "builders": [
    {
      "type": "amazon-ebs",
      "profile": "{{user `aws_profile`}}",
      "subnet_id": "{{user `aws_subnet`}}",
      "access_key": "{{user `aws_access_key`}}",
      "secret_key": "{{user `aws_secret_key`}}",
      "spot_price": "{{user `instance_price`}}",
      "region": "{{user `aws_region`}}",
      "source_ami": "{{user `ami_id`}}",
      "iam_instance_profile": "{{user `packer_profile`}}",
      "associate_public_ip_address": "false",
      "encrypt_boot": "true",
      "ssh_username": "{{user `ssh_user`}}",
      "instance_type": "{{user `aws_instance`}}",
      "run_tags": {
        "Name": "service-packer-builder"
      },
      "ami_name": "{{user `base_ami_name`}} v{{user `infra_version`}} - {{user `application_name`}}-{{user `kubernetes_ctl_version`}}",
      "tags": {
        "Name": "{{user `base_ami_name`}} v{{user `infra_version`}} - {{user `application_name`}}-{{user `kubernetes_ctl_version`}}",
        "Base_AMI_Name": "{{ .SourceAMIName }}",
        "Extra": "{{ .SourceAMITags.TagName }}"
      },
      "launch_block_device_mappings": [
        {
          "device_name": "/dev/sda1",
          "volume_size": 10,
          "volume_type": "gp2",
          "delete_on_termination": true
        }
      ]
    }
  ],

  "provisioners": [
    {
      "type": "shell",
      "execute_command": "{{ .Vars }} /bin/bash -vx '{{ .Path }}'",
      "inline": [
        "sudo yum -y install yum-utils device-mapper-persistent-data lvm2",
        "sudo yum-config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo",
        "sudo yum -y install docker-ce docker-ce-cli containerd.io",
        "sudo usermod -a -G docker $USER",
        "sudo systemctl enable docker.service"
      ]
    },
    {
      "type": "shell",
      "execute_command": "{{ .Vars }} /bin/bash -vx '{{ .Path }}'",
      "inline": [
        "sudo bash -c \"curl -sL https://rpm.nodesource.com/setup_8.x | bash -\"",
        "sudo yum -y install nodejs",
        "sudo npm i -g lerna@3.13.4 yarn@1.15.2"
      ]
    },
    {
      "type": "shell",
      "execute_command": "{{ .Vars }} /bin/bash -vx '{{ .Path }}'",
      "inline": [
        "sudo curl -L https://storage.googleapis.com/kubernetes-release/release/v{{user `kubernetes_ctl_version`}}/bin/linux/amd64/kubectl > {{user `root_dir`}}/kubectl-{{user `kubernetes_ctl_version`}}",
        "sudo chmod +x {{user `root_dir`}}/kubectl-{{user `kubernetes_ctl_version`}}",
        "sudo ln -s {{user `root_dir`}}/kubectl-{{user `kubernetes_ctl_version`}} /usr/local/bin/kubectl",
        "sudo ln -s {{user `root_dir`}}/kubectl-{{user `kubernetes_ctl_version`}} /usr/bin/kubectl",
        "sudo curl -L https://github.com/docker/compose/releases/download/{{user `docker_compose_version`}}/docker-compose-`uname -s`-`uname -m` > {{user `root_dir`}}/docker-compose-{{user `docker_compose_version`}}",
        "sudo chmod +x {{user `root_dir`}}/docker-compose-{{user `docker_compose_version`}}",
        "sudo ln -s {{user `root_dir`}}/docker-compose-{{user `docker_compose_version`}} /usr/local/bin/docker-compose",
        "sudo ln -s {{user `root_dir`}}/docker-compose-{{user `docker_compose_version`}} /usr/bin/docker-compose"
      ]
    }
  ]
}
