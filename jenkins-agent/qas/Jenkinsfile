pipeline {
  environment {

    SCRIPTS_SOURCE_DIR="qas-automation-aws"
    PACKER_DIR="jenkins-agent/qas/"

  }

  agent  {
    label "base-ec2-spot-worker"
  }

  stages {

    // Batch 1
    stage('Checkout QAS Update Automation Scripts') {
      agent {
        label "base-ec2-spot-worker"
      }
      steps {

        // checkout scripts
        dir("qas-automation-aws"){
          checkout scm: [
            $class: 'GitSCM',
            branches: [[name: "master"]],
            userRemoteConfigs: [[
              credentialsId: 'prd-private-gitlab',
              url: 'git@gitlab.usautoparts.com:platform-services/qas-automation-aws.git'
            ]]
          ]
        }
        // list after checkout
        sh "ls -l"
      }
      post {
        always {
          sh "date"
        }
      }
    }

    stage('Prepare Packer Build') {
      agent {
        label "base-ec2-spot-worker"
      }
      steps {

        // transfer scripts to slave working dir

        sh "rsync -avzpP ${SCRIPTS_SOURCE_DIR} ${PACKER_DIR}"

        dir("${PACKER_DIR}"){

          sh "ls -l"

        }

      }
      post {
        always {
          sh "date"
        }
      }
    }

    stage('Building Scripts AMI') {
      agent {
        label "base-ec2-spot-worker"
      }
      steps {

        dir("${PACKER_DIR}"){

          sh "packer build packerfile.json"

        }

      }
      post {
        always {
          sh "date"
        }
      }
    }
  }
}
