{
  "variables": {
    "instance_price": "1.0",
    "infra_version": "1.0.0",
    "aws_region": "us-west-2",
    "aws_subnet": "subnet-0d0368f6d2952ca72",
    "ami_id": "ami-0c663d99eef860d69",
    "aws_instance": "t2.small",
    "ssh_user": "centos",
    "base_ami_name": "Base Rtpi-Feeds",
    "application_name": "rtpi-feeds",
    "packer_profile": "packer-role",
    "aws_profile": "strata"
  },
  "builders": [{
    "type": "amazon-ebs",
    "profile": "{{user `aws_profile`}}",
    "subnet_id": "{{user `aws_subnet`}}",
    "access_key": "{{user `aws_access_key`}}",
    "secret_key": "{{user `aws_secret_key`}}",
    "spot_price": "{{user `instance_price`}}",
    "region": "{{user `aws_region`}}",
    "source_ami": "{{user `ami_id`}}",
    "iam_instance_profile": "{{user `packer_profile`}}",
    "associate_public_ip_address": "false",
    "encrypt_boot": "true",
    "ssh_username": "{{user `ssh_user`}}",
    "instance_type": "{{user `aws_instance`}}",
    "run_tags": {
      "Name": "service-packer-builder"
    },
    "ami_name": "{{user `base_ami_name`}} v{{user `infra_version`}} - {{user `application_name`}}",
    "tags": {
      "Name": "{{user `base_ami_name`}} v{{user `infra_version`}} - {{user `application_name`}}",
      "Base_AMI_Name": "{{ .SourceAMIName }}",
      "Extra": "{{ .SourceAMITags.TagName }}"
    },
    "launch_block_device_mappings": [{
      "device_name": "/dev/sda1",
      "volume_size": 10,
      "volume_type": "gp2",
      "delete_on_termination": true
    }]
  }],

  "provisioners": [{
    "type": "shell",
    "execute_command": "{{ .Vars }} /bin/bash -vx '{{ .Path }}'",
    "inline": [
      "sudo useradd svcdump",
      "mkdir -p /home/centos/.keyless/",
      "aws ssm get-parameter --profile strata --name 'svcdump-key' --region us-west-2 --query 'Parameter.Value' --output text > /home/centos/.keyless/svcdump.key",
      "chmod 400 /home/centos/.keyless/*",
      "sudo bash -c \"echo 34.237.35.136 ec2feedgen04 >> /etc/hosts\"",
      "sudo bash -c \"echo 10.10.70.97 gitlab.usautoparts.com >> /etc/hosts\"",
      "sudo bash -c \"echo 10.50.7.233 awsrtpbe02 >> /etc/hosts\""
    ]
  }]
}